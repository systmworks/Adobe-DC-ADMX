<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  revision="3.1" schemaVersion="1.0"
  xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="AdobeDC" namespace="Adobe.Policies.AdobeDC" />
  </policyNamespaces>
  <resources minRequiredRevision="3.1" />
  <supportedOn>
    <definitions>
      <definition displayName="$(string.SupportedAcrobatReaderPolicies)" name="SupportedAcrobatReaderPolicies"/>
      <definition displayName="$(string.SupportedReaderPolicies)" name="SupportedReaderPolicies"/>
      <definition displayName="$(string.SupportedAcrobatX64)" name="SupportedAcrobatX64"/>
      <definition displayName="$(string.SupportedAcrobatX86)" name="SupportedAcrobatX86"/>
      <definition displayName="$(string.SupportedReaderX86)" name="SupportedReaderX86"/>
      <definition displayName="$(string.SupportedAcrobatDC_User)" name="SupportedAcrobatDC_User"/>
      <definition displayName="$(string.SupportedReaderDC_User)" name="SupportedReaderDC_User"/>
    </definitions>
  </supportedOn>

  <categories>
    <category displayName="$(string.AdobeCategory)" name="AdobeCategory"/>
    <category displayName="$(string.AcrobatReaderPolicies)" name="AcrobatReaderPolicies">
      <parentCategory ref="AdobeCategory"/>
    </category>
    <category displayName="$(string.ReaderPoliciesBranch)" name="ReaderPoliciesBranch">
      <parentCategory ref="AdobeCategory"/>
    </category>
    <category displayName="$(string.NonPolicySettings)" name="NonPolicySettings">
      <parentCategory ref="AdobeCategory"/>
    </category>
    <category displayName="$(string.NonPol_AcrobatX64)" name="NonPol_AcrobatX64">
      <parentCategory ref="NonPolicySettings"/>
    </category>
    <category displayName="$(string.NonPol_AcrobatX86)" name="NonPol_AcrobatX86">
      <parentCategory ref="NonPolicySettings"/>
    </category>
    <category displayName="$(string.NonPol_ReaderX86)" name="NonPol_ReaderX86">
      <parentCategory ref="NonPolicySettings"/>
    </category>
    <category displayName="$(string.Cat_CloudConnectors)" name="CloudConnectors_AcrobatCategory">
      <parentCategory ref="AcrobatReaderPolicies"/>
    </category>
    <category displayName="$(string.Cat_CloudConnectors)" name="CloudConnectors_ReaderCategory">
      <parentCategory ref="ReaderPoliciesBranch"/>
    </category>
    <category displayName="$(string.Cat_ContextToolsSearch)" name="ContextToolsSearch_AcrobatCategory">
      <parentCategory ref="AcrobatReaderPolicies"/>
    </category>
    <category displayName="$(string.Cat_ContextToolsSearch)" name="ContextToolsSearch_ReaderCategory">
      <parentCategory ref="ReaderPoliciesBranch"/>
    </category>
    <category displayName="$(string.Cat_ContextToolsSearch)" name="ContextToolsSearch_AcrobatX64Category">
      <parentCategory ref="NonPol_AcrobatX64"/>
    </category>
    <category displayName="$(string.Cat_ContextToolsSearch)" name="ContextToolsSearch_AcrobatX86Category">
      <parentCategory ref="NonPol_AcrobatX86"/>
    </category>
    <category displayName="$(string.Cat_ContextToolsSearch)" name="ContextToolsSearch_ReaderX86Category">
      <parentCategory ref="NonPol_ReaderX86"/>
    </category>
    <category displayName="$(string.Cat_DocsEditAccess)" name="DocsEditAccess_AcrobatCategory">
      <parentCategory ref="AcrobatReaderPolicies"/>
    </category>
    <category displayName="$(string.Cat_DocsEditAccess)" name="DocsEditAccess_ReaderCategory">
      <parentCategory ref="ReaderPoliciesBranch"/>
    </category>
    <category displayName="$(string.Cat_DocsEditAccess)" name="DocsEditAccess_AcrobatX64Category">
      <parentCategory ref="NonPol_AcrobatX64"/>
    </category>
    <category displayName="$(string.Cat_DocsEditAccess)" name="DocsEditAccess_AcrobatX86Category">
      <parentCategory ref="NonPol_AcrobatX86"/>
    </category>
    <category displayName="$(string.Cat_DocsEditAccess)" name="DocsEditAccess_ReaderX86Category">
      <parentCategory ref="NonPol_ReaderX86"/>
    </category>
    <category displayName="$(string.Cat_MicrosoftPurviewMIP)" name="MicrosoftPurviewMIP_AcrobatCategory">
      <parentCategory ref="AcrobatReaderPolicies"/>
    </category>
    <category displayName="$(string.Cat_MicrosoftPurviewMIP)" name="MicrosoftPurviewMIP_ReaderCategory">
      <parentCategory ref="ReaderPoliciesBranch"/>
    </category>
    <category displayName="$(string.Cat_SecurityExec)" name="SecurityExec_AcrobatCategory">
      <parentCategory ref="AcrobatReaderPolicies"/>
    </category>
    <category displayName="$(string.Cat_SecurityExec)" name="SecurityExec_ReaderCategory">
      <parentCategory ref="ReaderPoliciesBranch"/>
    </category>
    <category displayName="$(string.Cat_SecurityExec)" name="SecurityExec_AcrobatX64Category">
      <parentCategory ref="NonPol_AcrobatX64"/>
    </category>
    <category displayName="$(string.Cat_SecurityExec)" name="SecurityExec_AcrobatX86Category">
      <parentCategory ref="NonPol_AcrobatX86"/>
    </category>
    <category displayName="$(string.Cat_SecurityExec)" name="SecurityExec_ReaderX86Category">
      <parentCategory ref="NonPol_ReaderX86"/>
    </category>
    <category displayName="$(string.Cat_SecurityTrust)" name="SecurityTrust_AcrobatCategory">
      <parentCategory ref="AcrobatReaderPolicies"/>
    </category>
    <category displayName="$(string.Cat_SecurityTrust)" name="SecurityTrust_ReaderCategory">
      <parentCategory ref="ReaderPoliciesBranch"/>
    </category>
    <category displayName="$(string.Cat_SharingFeatures)" name="SharingFeatures_AcrobatCategory">
      <parentCategory ref="AcrobatReaderPolicies"/>
    </category>
    <category displayName="$(string.Cat_SharingFeatures)" name="SharingFeatures_ReaderCategory">
      <parentCategory ref="ReaderPoliciesBranch"/>
    </category>
    <category displayName="$(string.Cat_StartupExperience)" name="StartupExperience_AcrobatCategory">
      <parentCategory ref="AcrobatReaderPolicies"/>
    </category>
    <category displayName="$(string.Cat_StartupExperience)" name="StartupExperience_ReaderCategory">
      <parentCategory ref="ReaderPoliciesBranch"/>
    </category>
    <category displayName="$(string.Cat_UpdatesDesktop)" name="UpdatesDesktop_AcrobatCategory">
      <parentCategory ref="AcrobatReaderPolicies"/>
    </category>
    <category displayName="$(string.Cat_UpdatesDesktop)" name="UpdatesDesktop_ReaderCategory">
      <parentCategory ref="ReaderPoliciesBranch"/>
    </category>
    <category displayName="$(string.Cat_UpdatesDesktop)" name="UpdatesDesktop_AcrobatX64Category">
      <parentCategory ref="NonPol_AcrobatX64"/>
    </category>
    <category displayName="$(string.Cat_UpdatesDesktop)" name="UpdatesDesktop_AcrobatX86Category">
      <parentCategory ref="NonPol_AcrobatX86"/>
    </category>
    <category displayName="$(string.Cat_UpdatesDesktop)" name="UpdatesDesktop_ReaderX86Category">
      <parentCategory ref="NonPol_ReaderX86"/>
    </category>
    <category displayName="$(string.Cat_Upsell)" name="Upsell_AcrobatCategory">
      <parentCategory ref="AcrobatReaderPolicies"/>
    </category>
    <category displayName="$(string.Cat_Upsell)" name="Upsell_ReaderCategory">
      <parentCategory ref="ReaderPoliciesBranch"/>
    </category>
    <category displayName="$(string.AcrobatDCCategory_User)" name="AcrobatDCCategory_User">
      <parentCategory ref="AdobeCategory"/>
    </category>
    <category displayName="$(string.Cat_ContextToolsSearch_User)" name="ContextToolsSearchCategoryDC_User">
      <parentCategory ref="AcrobatDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_DocsEditAccess_User)" name="DocsEditAccessCategoryDC_User">
      <parentCategory ref="AcrobatDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_MicrosoftPurviewMIP_User)" name="MicrosoftPurviewMIPCategoryDC_User">
      <parentCategory ref="AcrobatDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_SecurityExec_User)" name="SecurityExecCategoryDC_User">
      <parentCategory ref="AcrobatDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_SecurityTrust_User)" name="SecurityTrustCategoryDC_User">
      <parentCategory ref="AcrobatDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_SharingFeatures_User)" name="SharingFeaturesCategoryDC_User">
      <parentCategory ref="AcrobatDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_StartupExperience_User)" name="StartupExperienceCategoryDC_User">
      <parentCategory ref="AcrobatDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_UpdatesDesktop_User)" name="UpdatesDesktopCategoryDC_User">
      <parentCategory ref="AcrobatDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_Upsell_User)" name="UpsellCategoryDC_User">
      <parentCategory ref="AcrobatDCCategory_User"/>
    </category>
    <category displayName="$(string.ReaderDCCategory_User)" name="ReaderDCCategory_User">
      <parentCategory ref="AdobeCategory"/>
    </category>
    <category displayName="$(string.Cat_ContextToolsSearch_User)" name="ContextToolsSearchCategory_User">
      <parentCategory ref="ReaderDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_DocsEditAccess_User)" name="DocsEditAccessCategory_User">
      <parentCategory ref="ReaderDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_MicrosoftPurviewMIP_User)" name="MicrosoftPurviewMIPCategory_User">
      <parentCategory ref="ReaderDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_SecurityExec_User)" name="SecurityExecCategory_User">
      <parentCategory ref="ReaderDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_SecurityTrust_User)" name="SecurityTrustCategory_User">
      <parentCategory ref="ReaderDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_SharingFeatures_User)" name="SharingFeaturesCategory_User">
      <parentCategory ref="ReaderDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_StartupExperience_User)" name="StartupExperienceCategory_User">
      <parentCategory ref="ReaderDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_UpdatesDesktop_User)" name="UpdatesDesktopCategory_User">
      <parentCategory ref="ReaderDCCategory_User"/>
    </category>
    <category displayName="$(string.Cat_Upsell_User)" name="UpsellCategory_User">
      <parentCategory ref="ReaderDCCategory_User"/>
    </category>
  </categories>
  <policies>

    <!-- ======================================== -->
    <!--                                          -->
    <!--     Acrobat and Reader DC - policies     -->
    <!--                                          -->
    <!-- ======================================== -->

    <!-- ======================================== -->
    <!--           Cloud and Connectors           -->
    <!-- ======================================== -->

    <!-- Cloud & Connectors > Adobe Fill & Sign (AcrobatPolicies) -->
    <!-- bToggleFillSign   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html#idkeyname_1_9299 -->
    <policy class="Machine" displayName="$(string.bToggleFillSign_Acrobat)" explainText="$(string.bToggleFillSign_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown\cServices"
      name="bToggleFillSign_Acrobat" valueName="bToggleFillSign">
      <parentCategory ref="CloudConnectors_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="0" /></enabledValue>
      <disabledValue><decimal value="1" /></disabledValue>
    </policy>

    <!-- Cloud & Connectors > Box Cloud Connector (AcrobatPolicies) -->
    <!-- bBoxConnectorEnabled   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html#idkeyname_1_9966 -->
    <policy class="Machine" displayName="$(string.bBoxConnectorEnabled_Acrobat)" explainText="$(string.bBoxConnectorEnabled_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown\cServices"
      name="bBoxConnectorEnabled_Acrobat" valueName="bBoxConnectorEnabled">
      <parentCategory ref="CloudConnectors_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Cloud & Connectors > Document Cloud Services (AcrobatPolicies) -->
    <!-- bToggleAdobeDocumentServices   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html#idkeyname_1_9204 -->
    <policy class="Machine" displayName="$(string.bToggleAdobeDocumentServices_Acrobat)" explainText="$(string.bToggleAdobeDocumentServices_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown\cServices"
      name="bToggleAdobeDocumentServices_Acrobat" valueName="bToggleAdobeDocumentServices">
      <parentCategory ref="CloudConnectors_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="0" /></enabledValue>
      <disabledValue><decimal value="1" /></disabledValue>
    </policy>

    <!-- Cloud & Connectors > Document Cloud Storage (AcrobatPolicies) -->
    <!-- bToggleDocumentCloud   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html#idkeyname_1_9877 -->
    <policy class="Machine" displayName="$(string.bToggleDocumentCloud_Acrobat)" explainText="$(string.bToggleDocumentCloud_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown\cServices"
      name="bToggleDocumentCloud_Acrobat" valueName="bToggleDocumentCloud">
      <parentCategory ref="CloudConnectors_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="0" /></enabledValue>
      <disabledValue><decimal value="1" /></disabledValue>
    </policy>

    <!-- Cloud & Connectors > Dropbox Cloud Connector (AcrobatPolicies) -->
    <!-- bDropboxConnectorEnabled   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html#idkeyname_1_10016 -->
    <policy class="Machine" displayName="$(string.bDropboxConnectorEnabled_Acrobat)" explainText="$(string.bDropboxConnectorEnabled_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown\cServices"
      name="bDropboxConnectorEnabled_Acrobat" valueName="bDropboxConnectorEnabled">
      <parentCategory ref="CloudConnectors_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Cloud & Connectors > Generative AI Technology (AcrobatPolicies) -->
    <!-- bEnableGentech   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html -->
    <policy class="Machine" displayName="$(string.bEnableGentech_Acrobat)" explainText="$(string.bEnableGentech_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown"
      name="bEnableGentech_Acrobat" valueName="bEnableGentech">
      <parentCategory ref="CloudConnectors_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Cloud & Connectors > Google Drive Connector (AcrobatPolicies) -->
    <!-- bGoogleDriveConnectorEnabled   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html#idkeyname_1_10116 -->
    <policy class="Machine" displayName="$(string.bGoogleDriveConnectorEnabled_Acrobat)" explainText="$(string.bGoogleDriveConnectorEnabled_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown\cServices"
      name="bGoogleDriveConnectorEnabled_Acrobat" valueName="bGoogleDriveConnectorEnabled">
      <parentCategory ref="CloudConnectors_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Cloud & Connectors > Hide Fill & Sign Send a Copy Button (AcrobatPolicies) -->
    <!-- bToggleSendACopy   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html#idkeyname_1_9255 -->
    <policy class="Machine" displayName="$(string.bToggleSendACopy_Acrobat)" explainText="$(string.bToggleSendACopy_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown\cServices"
      name="bToggleSendACopy_Acrobat" valueName="bToggleSendACopy">
      <parentCategory ref="CloudConnectors_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="0" /></enabledValue>
      <disabledValue><decimal value="1" /></disabledValue>
    </policy>

    <!-- Cloud & Connectors > Hide Sign Out Menu Item (AcrobatPolicies) -->
    <!-- bSuppressSignOut   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html#idkeyname_1_10403 -->
    <policy class="Machine" displayName="$(string.bSuppressSignOut_Acrobat)" explainText="$(string.bSuppressSignOut_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown"
      name="bSuppressSignOut_Acrobat" valueName="bSuppressSignOut">
      <parentCategory ref="CloudConnectors_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Cloud & Connectors > OneDrive Connector (AcrobatPolicies) -->
    <!-- bOneDriveConnectorEnabled   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html#idkeyname_1_10066 -->
    <policy class="Machine" displayName="$(string.bOneDriveConnectorEnabled_Acrobat)" explainText="$(string.bOneDriveConnectorEnabled_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown\cServices"
      name="bOneDriveConnectorEnabled_Acrobat" valueName="bOneDriveConnectorEnabled">
      <parentCategory ref="CloudConnectors_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Cloud & Connectors > Preferences Synchronization (AcrobatPolicies) -->
    <!-- bTogglePrefsSync   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html#idkeyname_1_9582 -->
    <policy class="Machine" displayName="$(string.bTogglePrefsSync_Acrobat)" explainText="$(string.bTogglePrefsSync_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown\cServices"
      name="bTogglePrefsSync_Acrobat" valueName="bTogglePrefsSync">
      <parentCategory ref="CloudConnectors_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="0" /></enabledValue>
      <disabledValue><decimal value="1" /></disabledValue>
    </policy>

    <!-- Cloud & Connectors > Services & Web-Plugin Updates (AcrobatPolicies) -->
    <!-- bUpdater   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html#idkeyname_1_9154 -->
    <policy class="Machine" displayName="$(string.bUpdater_Updates_Acrobat)" explainText="$(string.bUpdater_Updates_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown\cServices"
      name="bUpdater_Updates_Acrobat" valueName="bUpdater">
      <parentCategory ref="CloudConnectors_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Cloud & Connectors > Third-Party Cloud Connectors (AcrobatPolicies) -->
    <!-- bToggleWebConnectors   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html#idkeyname_1_9921 -->
    <policy class="Machine" displayName="$(string.bToggleWebConnectors_Acrobat)" explainText="$(string.bToggleWebConnectors_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown\cServices"
      name="bToggleWebConnectors_Acrobat" valueName="bToggleWebConnectors">
      <parentCategory ref="CloudConnectors_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="0" /></enabledValue>
      <disabledValue><decimal value="1" /></disabledValue>
    </policy>

    <!-- ======================================== -->
    <!--        Context, Tools and Search         -->
    <!-- ======================================== -->

    <!-- Context, Tools & Search > Auto UI Density Detection (AcrobatPolicies) -->
    <!-- bUIDensityAutoDetectionEnabled   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html -->
    <policy class="Machine" displayName="$(string.bUIDensityAutoDetectionEnabled_Acrobat)" explainText="$(string.bUIDensityAutoDetectionEnabled_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown"
      name="bUIDensityAutoDetectionEnabled_Acrobat" valueName="bUIDensityAutoDetectionEnabled">
      <parentCategory ref="ContextToolsSearch_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Context, Tools & Search > Cloud Search Token Caching (AcrobatPolicies) -->
    <!-- bEnableCloudPoweredSearchTokenCaching   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html#idkeyname_1_12719 -->
    <policy class="Machine" displayName="$(string.bEnableCloudPoweredSearchTokenCaching_Acrobat)" explainText="$(string.bEnableCloudPoweredSearchTokenCaching_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown"
      name="bEnableCloudPoweredSearchTokenCaching_Acrobat" valueName="bEnableCloudPoweredSearchTokenCaching">
      <parentCategory ref="ContextToolsSearch_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Context, Tools & Search > Cloud-Powered Search (AcrobatPolicies) -->
    <!-- bEnableCloudPoweredSearch   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html#idkeyname_1_12671 -->
    <policy class="Machine" displayName="$(string.bEnableCloudPoweredSearch_Acrobat)" explainText="$(string.bEnableCloudPoweredSearch_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown"
      name="bEnableCloudPoweredSearch_Acrobat" valueName="bEnableCloudPoweredSearch">
      <parentCategory ref="ContextToolsSearch_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Context, Tools & Search > Contextual Help Tips (AcrobatPolicies) -->
    <!-- bEnableContextualTips   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html -->
    <policy class="Machine" displayName="$(string.bEnableContextualTips_Acrobat)" explainText="$(string.bEnableContextualTips_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown"
      name="bEnableContextualTips_Acrobat" valueName="bEnableContextualTips">
      <parentCategory ref="ContextToolsSearch_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Context, Tools & Search > Contextual Toolbar (AcrobatPolicies) -->
    <!-- bEnableContextualToolbar   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html -->
    <policy class="Machine" displayName="$(string.bEnableContextualToolbar_Acrobat)" explainText="$(string.bEnableContextualToolbar_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown"
      name="bEnableContextualToolbar_Acrobat" valueName="bEnableContextualToolbar">
      <parentCategory ref="ContextToolsSearch_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Context, Tools & Search > Extract Page Range UI (AcrobatPolicies) -->
    <!-- bEnableExtractPageRange   https://www.adobe.com/devnet-docs/acrobatetk/tools/PrefRef/Windows/FeatureLockDown.html -->
    <policy class="Machine" displayName="$(string.bEnableExtractPageRange_Acrobat)" explainText="$(string.bEnableExtractPageRange_Acrobat_Explain)" key="SOFTWARE\Policies\Adobe\Adobe Acrobat\DC\FeatureLockDown"
      name="bEnableExtractPageRange_Acrobat" valueName="bEnableExtractPageRange">
      <parentCategory ref="ContextToolsSearch_AcrobatCategory"/>
      <supportedOn ref="SupportedAcrobatReaderPolicies"/>
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

